# ── Smyth Super Agent — Environment Template ──
# Copy this file to .env.local and fill in YOUR values.
# DO NOT commit .env.local. It is ignored by default.
#
# Each variable below documents whether it is REQUIRED, RECOMMENDED,
# or OPTIONAL for the app to function. Remove hardcoded keys before
# building/shipping the app.

# ── 1. OpenClaw Gateway (REQUIRED if using openclaw/* models) ──
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=

# ── 2. Ollama API key (REQUIRED for cloud model pools) ──
# Get your key at https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# ── 3. Local Ollama (OPTIONAL — used as offline fallback) ──
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OLLAMA_API_KEY=ollama-local

# ── 4. OmniRoute (REQUIRED if using omniroute/* models) ──
OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
OMNIROUTE_API_KEY=

# ── 5. Parallel Web / AI Search (REQUIRED for research & tool search) ──
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai

# ── 6. AgenticMail (REQUIRED for email panel, auto-respond, bypass APIs) ──
AGENTICMAIL_MASTER_KEY=
NEXT_PUBLIC_AGENTICMAIL_MASTER_KEY=${AGENTICMAIL_MASTER_KEY}
AGENTICMAIL_DB=/path/to/agenticmail.db

# ── 7. Zernio Social Media Scheduler (REQUIRED for posting/scheduling) ──
ZERNIO_API_URL=https://api.zernio.com/v1
ZERNIO_API_KEY=

# ── 8. Perchance AI Image Generation (REQUIRED for image tools) ──
PERCHANCE_COOKIE=
PERCHANCE_USER_KEY=
PERCHANCE_DEVICE_ID=

# ── 9. Twenty CRM (OPTIONAL — enable in mcp-servers.yaml first) ──
TWENTY_MCP_TOKEN=

# ── 10. EchoVision / Webcam / Senses (REQUIRED if using vision tools) ──
# Absolute paths on the target machine. Replace with your own install paths.
ECHO_VISION_PATH=/path/to/echovision/echovision.py
ECHO_VISION_SIDECAR=/path/to/echovision-server.py
VISION_SKILL_PATH=/path/to/skills/echovision/vision.py
NOTETAKER_SCRIPT=/path/to/smyth/scheduling/notetaker.py

# ── 11. Workspace / Scripts paths (REQUIRED — app needs a workspace directory) ──
SMYTH_WORKSPACE=/path/to/smyth-super-agent/workspace
PYTHON_SCRIPTS_REPO=/path/to/Python-project-Scripts
BROWSER_SENSE_SCRIPT=/path/to/smyth-super-agent/senses/browser.py
VIDEO_WATCH_SCRIPT=/path/to/smyth-super-agent/video-tools/watch.py

# ── 11b. Browser automation launcher (OPTIONAL — for CDP browser on :9223) ──
# Path to a script that starts a Chromium instance with remote debugging on
# port 9223. Leave blank to disable browser-launch (browser tools then require
# a browser already running on :9223).
BROWSER_LAUNCH_SCRIPT=

# ── 14. Replicate Image/Flux generation (REQUIRED if using Flux tools) ──
REPLICATE_API_TOKEN=
REPLICATE_VERSION_ID=

# ── 12. Runtime temp directories (optional; defaults are fine for most users) ──
SMYTH_TEMP_DIR=/tmp/smyth
SMYTH_WEBCAM_DIR=/tmp/smyth-webcam
SMYTH_JOB_LOG_DIR=/tmp/smyth-jobs

# ── 15. MCP Servers (REQUIRED only for servers you enable in mcp-servers.yaml) ──
BRAVE_API_KEY=
GITHUB_TOKEN=
DATABASE_URL=
OPENPENCIL_MCP_PATH=/path/to/openpencil-mcp

# ── 16. First-run / onboarding (REMOVE before shipping — only for setup UI) ──
NEXT_PUBLIC_APP_NAME=Smyth Super Agent
