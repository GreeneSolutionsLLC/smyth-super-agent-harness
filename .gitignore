# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# electron build artifacts
/dist/
/electron/dist/
/electron/.track-*-done
/electron/build-scripts/*.bak

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docs/TOOLS.md
memory/*
!memory/2026-07-04.md
.shared/
.env.local
vendor/velorn/
vendor/open-pencil/

# operator runtime artifacts
/operator/reviews/
/workspace/

# local video projects
/video-projects/

# local plan scratch
/smyth_promo_plan.txt
.next.bak-*/
__pycache__/

# MCP OAuth tokens (contains live access/refresh tokens)
.mcp-oauth-tokens.json
.operator-state/

# MCP per-server auto-auth kill-switch state (default OFF for canva/twenty)
.mcp-auto-auth.json

# Runtime usage / optimization data (regenerated by usage-log + scheduler)
data/usage-log.json
data/optimization-report.json
data/ollama-usage-history.json

# Trashed backup files (kept locally only)
**/*.bak
**/*.bak-*
